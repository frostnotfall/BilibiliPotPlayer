{
    // 可手动设定关闭快捷键：设置 - 基本 - 快捷键 - 添加 - 字幕 - 选择字幕 - 不显示，Alt+;
    // 再次打开可使用快捷键：Alt+L依次切换。
    // 视频字幕
    "subtitle": {
        // 是否启用字幕。默认：false。如果不存在视频自有字幕，则使用ai字幕。注：1. 使用内置解析生成字幕会增加视频打开延迟，推荐按需开启。2. 当设定为true，弹幕变为次字幕。
        "enable": false,
        // 字幕服务器地址，若不指定，将使用内置解析生成字幕。推荐指定字幕服务器地址。
        "server": ""
    },

    // 当 subtitle - enable 为 true 时，弹幕将作为次字幕显示。如需要同时输出。按如下设置：
    // 1. 设置 - 字幕 - 语言/同步/其它 - 次字幕语言, 填入 "弹幕"。
    // 2. 勾选"当存在两个以上字幕语言时同时输出次字幕语言"。
    // 弹幕
    "danmaku": {
        // 控制是否接收弹幕。按 Alt+H 可显示/隐藏弹幕
        "enable": true,
        // 弹幕服务器地址，若不指定，将使用内置解析生成弹幕。注：使用内置解析生成弹幕会增加视频打开延迟。推荐指定弹幕服务器地址。
        "server": "",
        // 字体
        "font": "微软雅黑 Light",
        // 字号
        "fontSize": 24.0,
        // 弹幕不透明度，取值范围 0.0 ~ 1.0
        "opacity": 0.3,
        // 弹幕显示区域大小，取值范围 0.0 ~ 1.0
        "displayArea": 0.8,
        // 弹幕显示时间
        "stayTime": 15.0
    },

    // 播放单个视频/直播时是否显示推荐的视频/直播。默认：false。
    "showRecommendedVideos": false,

    // 是否显示番剧/电影预告片。默认：true。
    "showTrailer": true,

    // 是否屏蔽 P2P CDN。默认：true。
    "blockP2PCDN": true,

    // 设定请求缓存的时间，单位(s)。默认：300。
    "cacheValidTime": 300,

    // 启用空降助手，默认：false。其域名 ipv6 地址波动较大，如遇到 potplayer 超时问题先禁用。
    "enableSponsorBlock": false,
    // 空降助手镜像地址
    "sponsorBlockMirror": "",

    // 心跳上报。默认：false。用于同步bilibili历史记录。目前默认只支持点播，直播需要指定 bili_jct。 
    "heartBeat" : false,

    // 各类页面的视频生成数量。数字越大视频越多，但会增加加载时间，极端情况会因超时而加载失败，以及触发风控，需谨慎设置。
    "videoNums": {
        // “我的动态”页数，默认 50。从 “我的动态” 页面(每次查询20个)过滤出视频，视频数量取决于实际情况。
        "webDynamicVideoNums": 50,
        // "首页推荐"视频数量，默认 30。从 “推荐” 页面获取的视频数量，最终数量可能会大于设置的值。提醒:点击播放列表名字可刷新，无需设定太多数量。
        "recommendVideoNums": 30,
        // "直播首页" 推荐的直播间页数，默认 1。（每页推荐返回15个房间）。提醒:点击播放列表名字可刷新，无需设定太多数量。
        "liveRecommendPage": 1,
        // "历史记录"视频数量，默认 30。从 “历史记录” 页面获取的视频数量，最终数量可能会大于设置的值。
        "historyVideoNums": 30,
        // “综合热门” 页数，默认 1。（每页查询50个）。
        "popularAllPages": 1,
        // 个人“空间动态” 视频数量，默认 30。从 个人“空间动态” 页面获取的视频数量，最终数量可能会大于设置的值。
        "spaceDynamicVideoNums": 30,
        // 直播分区页面查询的最大房间数，默认 40，每页返回20个房间。
        "maxliveroom": 100
    },

    // 直播
    "live": {
        // 官方提供 http_stream(flv) 与 http_hls(ts/fmp4)。
        // http_stream 延迟更低，但：1.pk时可能会断开; 2.存在官方可能降画质的情况。
        // http_hls 可能会出现"no desc"标题。注：只有http_hls(fmp4) 可能会提供av1编码。
        // 使用 http_stream (flv)。默认：false。
        "useHttpStream": false,
        // 解析真实 M3U8 地址。当出现 M3U8 redirect 时，potplayer 会将该播放流名称覆盖为 HLS；若开启，则会尝试解析真实的 M3U8 地址，但会造成额外的请求延迟。当出现 "解析真实M3U8地址" 时间过长时，可以尝试关闭此项。
        "parseM3u8RealUrl": {
            // 默认：false。
            "enable": false,
            // 快速模式。默认：false。只对 m3u8RedirectDomain 列表中的域名解析真实 M3U8 地址, 若遇到不在 M3U8 redirect 的域名时，会失效。
            "fastMode": false,
            "m3u8RedirectDomains": ["gotcha204.bilivideo.com", "gotcha204b.bilivideo.com"]
        },
        // 直播聊天窗口配置，观看直播时 potplayer 播放列表侧会出现聊天窗口。
        "liveChatUrl": {
            // 使用 Bilibili_Danmuji 服务，默认：false。需自己部署 Bilibili_Danmuji 服务。useBilibiliDanmuji 优先级高于 useWebPage。
            "useBilibiliDanmuji": false,
            // BBilibili_Danmuji 地址。
            "bilibiliDanmujiServer": ""
        },
        // 直播缩略图使用关键帧截图(如果存在)。默认：false。
        "useKeyframe": false
    },

    // 禁用 AVC 编码（仅当存在其他编码时生效）。默认：false。仅当存在其他编码时生效。可根据个人需求使用。推荐设为 true，以免影响默认画质选择。不包括直播。
    "disableAVC": false,

    // 以下配置项帮助默认选择最优画质。
    // 默认编码选择优先级。默认: ["hevc", "av1", "avc"]。考虑到硬解支持的广泛性，默认优先 hevc。如果你的设备支持 av1 硬解，可将 av1 提升优先级。
    "defaultCodec": ["hevc", "av1", "avc"],
    // HDR优先。默认：false。跟随官方设定，“8K超高清” 优先级高于 “HDR/杜比视界”。设为 true：“杜比视界/HDR真彩色” 优先级高于“8K超高清”。
    "preferHDR": false,

    // Bilibili CSRF Token，用于直播心跳上报。
    // 获取方式：
    // 1. 下载 yt-dlp 2. 关闭 Potplayer 3. 注意 Potplayer 安装路径 4. 随便指定一个视频url
    // .\yt-dlp.exe --skip-download --cookies-from-browser "chrome:D:\Program Files\DAUM\PotPlayer\WebView2\EBWebView" --cookies potplayer-cookies.txt "https://www.bilibili.com/video/BVxxxx"
    "bili_jct": "",

    "debug": false
}