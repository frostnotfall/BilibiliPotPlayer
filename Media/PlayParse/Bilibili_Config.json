{
    "maxliveroom": 200,
    "danmaku": {
        // 控制是否接收弹幕。按 Alt+H 可显示/隐藏弹幕
        "enable": true,
        "server": "",
        // 字体
        "font": "微软雅黑 Light",
        // 字号
        "fontSize": 24.0,
        // 弹幕不透明度，取值范围 0.0 ~ 1.0
        "opacity": 0.3,
        // 弹幕显示区域大小，取值范围 0.0 ~ 1.0
        "displayArea": 0.8,
        // 弹幕显示时间
        "stayTime": 15.0
    },
    // 播放单个视频时是否显示推荐的视频
    "showRecommendedVideos": true,
    // 是否屏蔽 P2P CDN
    "blockP2PCDN": true,
    // 设定请求缓存的时间，单位(s)
    "cacheValidTime": 300,
    // 启用空降助手，其域名 ipv6 地址波动较大，如遇到 potplayer 超时问题先禁用
    "enableSponsorBlock": false,
    // 空降助手镜像地址
    "sponsorBlockMirror": "",
    // 废弃，经测试对画质选择无影响。
    // 默认：false。少数情况会出现低画质流 itag 高于高画质流的情况，禁用 AVC 可绝对避免此种情况。
    "disableAVC": true,
    // HDR优先。默认：false。跟随官方设定，“8K超高清” itag 高于 “HDR/杜比视界”。设为 true：“杜比视界/HDR真彩色” itag 高于“8K超高清”。
    "preferHDR": true,
    "debug": false
}